<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底部投影层 -->
    <item android:top="2dp">
        <shape>
            <gradient android:angle="270" android:startColor="#2e0b3d20" android:endColor="#100b3d20" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- 浅绿玻璃主体 -->
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#e6f3fbf3" android:centerColor="#c8e4f5e8" android:endColor="#a8d2eeD8" />
            <stroke android:width="1dp" android:color="#ccffffff" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
