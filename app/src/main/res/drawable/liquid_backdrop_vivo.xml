            <gradient android:type="radial" android:gradientRadius="300dp" android:startColor="#faecd0c8" android:endColor="#009f7b00" />
        </shape>
    </item>
    <item android:bottom="-220dp" android:left="-140dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="340dp" android:startColor="#ddd5a6b8" android:endColor="#006d5800" />
        </shape>
    </item>
</layer-list>
