<?xml version="1.0" encoding="utf-8"?>
<!-- YunX 网盘分享解析：紫蓝渐变玻璃卡片 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="135" android:startColor="#4C1D95" android:centerColor="#6D28D9" android:endColor="#2563EB" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <solid android:color="#10000000" />
            <stroke android:width="1dp" android:color="#D9FFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="18dp">
        <shape>
            <gradient android:angle="0" android:startColor="#00ffffff" android:centerColor="#52ffffff" android:endColor="#00ffffff" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
