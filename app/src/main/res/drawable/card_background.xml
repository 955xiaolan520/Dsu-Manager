<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃卡片：深色衬底 + 半透明渐变玻璃面 + 高光描边（与宿主 liquid_glass_panel 同风格） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3027465C" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E0FFFFFF"
                android:centerColor="#C4F2F6FC"
                android:endColor="#A8ECF0F8" />
            <stroke
                android:width="1dp"
                android:color="#78F3FBFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
