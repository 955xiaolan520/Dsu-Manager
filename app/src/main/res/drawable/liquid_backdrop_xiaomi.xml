            <gradient android:type="radial" android:gradientRadius="300dp" android:startColor="#faddd0c8" android:endColor="#009f5800" />
        </shape>
    </item>
    <item android:bottom="-220dp" android:left="-140dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="340dp" android:startColor="#ddc5a6b8" android:endColor="#006d3500" />
        </shape>
    </item>
</layer-list>
