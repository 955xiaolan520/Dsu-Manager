<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底部投影层 -->
    <item android:top="2dp">
        <shape>
            <gradient android:angle="270" android:startColor="#40000000" android:endColor="#14000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- 玻璃主体 -->
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#f2ffffff" android:centerColor="#d8eef2f6" android:endColor="#b4d6e0ea" />
            <stroke android:width="1dp" android:color="#d9ffffff" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item android:top="1dp" android:left="2dp" android:right="2dp" android:bottom="10dp">
        <shape>
            <gradient android:angle="0" android:startColor="#00ffffff" android:centerColor="#66ffffff" android:endColor="#00ffffff" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
