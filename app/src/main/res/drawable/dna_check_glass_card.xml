<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape>
            <solid android:color="#18708596" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#78F5FAFC" android:centerColor="#65DCEAF0" android:endColor="#55B8CBD5" />
            <stroke android:width="1dp" android:color="#C7FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="2dp" android:right="2dp" android:bottom="12dp">
        <shape>
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#54FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
