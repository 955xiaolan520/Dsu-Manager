<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 轨道 -->
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#805A718A" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- 渐变进度填充 -->
    <item android:id="@android:id/progress">
        <clip xmlns:android="http://schemas.android.com/apk/res/android"
            android:clipOrientation="horizontal" android:gravity="left">
            <shape>
                <gradient android:angle="0" android:startColor="#3158C9" android:centerColor="#4f8fd6" android:endColor="#58C9A8" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
