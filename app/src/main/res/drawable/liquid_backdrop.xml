            <gradient android:type="radial" android:gradientRadius="300dp" android:startColor="#d0ecfac8" android:endColor="#007b9f00" />
        </shape>
    </item>
    <item android:bottom="-220dp" android:left="-140dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="340dp" android:startColor="#a6ddd5b8" android:endColor="#007c6d00" />
        </shape>
    </item>
