<?xml version="1.0" encoding="utf-8"?>
<!-- OTA合并工具卡片液态玻璃框：青色渐变 + 白描边 + 顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="135" android:startColor="#155E75" android:endColor="#06B6D4" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <solid android:color="#12000000" />
            <stroke android:width="1dp" android:color="#CFFFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="18dp">
        <shape>
            <gradient android:angle="0" android:startColor="#00ffffff" android:centerColor="#59ffffff" android:endColor="#00ffffff" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
