<resources>
    <color name="icon_background">#07111F</color>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#3F51B5</item>
        <item name="android:navigationBarColor">#F6F7FB</item><item name="android:statusBarColor">#F6F7FB</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    
    <style name="RoundedDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
    </style>
</resources>
