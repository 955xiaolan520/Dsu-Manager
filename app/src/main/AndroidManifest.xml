<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INSTALL_DYNAMIC_SYSTEM" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_DYNAMIC_SYSTEM" />
    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v3.9.13 「打开文件位置」选择器需要看到其他文件管理器（Android 11+ 包可见性） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="file" />
        </intent>
    </queries>
    <application android:theme="@style/AppTheme" android:label="Dsu 管理器" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:allowBackup="false" android:supportsRtl="true" android:requestLegacyExternalStorage="true" android:extractNativeLibs="true" android:enableOnBackInvokedCallback="false">
        <activity android:name=".OnboardingActivity" android:screenOrientation="portrait" android:exported="true" android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:screenOrientation="portrait" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SettingsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".AboutActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".RomActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".DownloadManagerActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".VivoActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".OPlusActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".OPlusLookupActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".OPlusOtaActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".PayloadDumperActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".OtaMergeActivity" android:screenOrientation="portrait" android:exported="false" />
        <service android:name=".DownloadService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="dataSync" />
        <!-- v3.9.13 PackageInstaller 自更新安装结果回调（显式 PendingIntent，无需导出） -->
        <receiver android:name=".UpdateInstallReceiver" android:exported="false" />
        <activity android:name=".MoreActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".LinuxTerminalActivity" android:theme="@style/LinuxTerminalTheme" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".AlpineTerminalActivity" android:theme="@style/LinuxTerminalTheme" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".UbuntuTerminalActivity" android:theme="@style/LinuxTerminalTheme" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".DebianTerminalActivity" android:theme="@style/LinuxTerminalTheme" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".LocalTerminalActivity" android:theme="@style/LinuxTerminalTheme" android:screenOrientation="portrait" android:exported="false" />
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
