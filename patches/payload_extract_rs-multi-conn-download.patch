-                    remote_off,
-                    length,
-                    &write_file,
-                    file_base,
-                    &downloaded,
-                )
-                .await
-            }));
+            let n_splits = if length > SPLIT_CHUNK_BYTES {
+                (((length + SPLIT_CHUNK_BYTES - 1) / SPLIT_CHUNK_BYTES) as usize)
+                    .min(MAX_CONNECTIONS)
+                    .max(1)
+            } else {
+                1
+            };
+            let chunk_len = length / n_splits as u64;
+            for s in 0..n_splits {
+                let this_off = data_region_off + chunk_len * s as u64;
+                let this_len = if s == n_splits - 1 {
+                    length - chunk_len * s as u64
+                } else {
+                    chunk_len
+                };
+                if this_len == 0 {
+                    continue;
+                }
+                let client = client.clone();
